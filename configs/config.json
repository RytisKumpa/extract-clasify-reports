                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Competitive position and market share analysis."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Market analysis including TAM/SAM/SOM and competitive positioning."
