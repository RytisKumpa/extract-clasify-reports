{
  "classify": {
    "product_type": "classify_v2",
    "configuration_id": null,
    "rules": [
      {
        "type": "commercial_dd",
        "description": "Commercial due diligence report analyzing market positioning, competitive landscape, customer base, revenue model, and growth opportunities. Focuses on market size (TAM/SAM/SOM), competitive moat, unit economics, and commercial viability. Look for: market analysis, customer interviews, competitive analysis, revenue drivers."
      },
      {
        "type": "tech_it_dd",
        "description": "Technology and IT due diligence report evaluating technology stack, software architecture, IT infrastructure, cybersecurity posture, technical debt, scalability, and technology capabilities. Look for: technology assessment, system architecture, security review, technical infrastructure analysis."
      },
      {
        "type": "financial_dd",
        "description": "Financial due diligence report analyzing financial statements, revenue quality, profitability, working capital, cash flow, debt structure, and financial projections. Focuses on financial health, accounting quality, and financial performance. Look for: financial analysis, accounting review, quality of earnings, financial projections."
      },
      {
        "type": "operations_dd",
        "description": "Operations due diligence report evaluating operational efficiency, supply chain, manufacturing processes, operational metrics, cost structure, and operational capabilities. Focuses on operational excellence and scalability. Look for: operational assessment, supply chain analysis, manufacturing capabilities, operational efficiency."
      },
      {
        "type": "legal_dd",
        "description": "Legal due diligence report reviewing corporate structure, contracts, intellectual property, regulatory compliance, litigation, and legal risks. Focuses on legal health and potential liabilities. Look for: legal review, contract analysis, IP assessment, regulatory compliance."
      },
      {
        "type": "regulatory_dd",
        "description": "Regulatory due diligence report analyzing regulatory environment, compliance status, regulatory risks, licenses, permits, and regulatory challenges. Focuses on regulatory compliance and risks. Look for: regulatory assessment, compliance review, licensing analysis."
      },
      {
        "type": "esg_dd",
        "description": "Environmental, Social, and Governance due diligence report evaluating ESG factors, sustainability practices, social impact, governance structure, and ESG risks/opportunities. Look for: ESG assessment, sustainability analysis, governance review, social impact evaluation."
      },
      {
        "type": "hr_people_dd",
        "description": "Human Resources and People due diligence report analyzing workforce composition, organizational structure, talent acquisition, retention, compensation, and human capital risks. Look for: HR assessment, organizational analysis, talent review, compensation structure."
      },
      {
        "type": "tax_dd",
        "description": "Tax due diligence report reviewing tax structure, tax compliance, tax liabilities, tax planning, and tax risks. Focuses on tax efficiency and compliance. Look for: tax analysis, compliance review, tax structure assessment."
      },
      {
        "type": "insurance_dd",
        "description": "Insurance due diligence report evaluating insurance coverage, risk management, claims history, insurance adequacy, and insurance gaps. Look for: insurance review, risk assessment, coverage analysis."
      },
      {
        "type": "environmental_dd",
        "description": "Environmental due diligence report analyzing environmental impact, contamination, environmental compliance, environmental risks, and sustainability practices. Look for: environmental assessment, contamination review, compliance analysis."
      },
      {
        "type": "investment_memorandum",
        "description": "Investment memorandum providing investment thesis, opportunity overview, financial highlights, market positioning, and investment rationale. Typically prepared by investment banks or financial advisors. Look for: investment thesis, opportunity overview, investment rationale, financial highlights."
      },
      {
        "type": "information_memorandum_teaser",
        "description": "Information memorandum teaser or preliminary investment document providing high-level overview of investment opportunity, key highlights, and basic investment information. Look for: teaser content, opportunity overview, key investment highlights."
      },
      {
        "type": "management_presentation",
        "description": "Management presentation or pitch deck presenting company overview, business model, market opportunity, financial performance, and growth strategy to investors. Look for: company overview, business model, market opportunity, financial presentation."
      },
      {
        "type": "pitch_deck",
        "description": "Pitch deck presenting investment opportunity, business concept, market opportunity, team, and investment terms to potential investors. Look for: pitch content, investment proposition, business concept presentation."
      },
      {
        "type": "financial_statement",
        "description": "Financial statement including balance sheet, income statement, cash flow statement, and financial metrics. Focuses on historical financial performance and position. Look for: financial statements, balance sheet, income statement, cash flow statement."
      },
      {
        "type": "annual_report",
        "description": "Annual report including financial statements, management discussion, business overview, and corporate governance information. Provides comprehensive annual performance review. Look for: annual financial report, MD&A, business description, corporate governance."
      },
      {
        "type": "quarterly_report",
        "description": "Quarterly report including quarterly financial statements, management discussion, and business updates. Focuses on quarterly performance and period-over-period comparisons. Look for: quarterly financial report, quarterly results, period updates."
      },
      {
        "type": "internal_document",
        "description": "Internal company document including strategy documents, internal memos, board materials, and internal analysis. Look for: internal content, strategy documents, internal analysis, board materials."
      },
      {
        "type": "board_pack",
        "description": "Board pack or board meeting materials including board presentations, financial reports, strategic updates, and governance information prepared for board meetings. Look for: board materials, board presentation, governance content."
      },
      {
        "type": "analyst_report",
        "description": "Analyst report providing investment analysis, company assessment, financial analysis, and investment recommendations from sell-side or buy-side analysts. Look for: analyst analysis, investment recommendation, company assessment, financial analysis."
      },
      {
        "type": "market_research_report",
        "description": "Market research report providing industry analysis, market size, trends, competitive landscape, and market outlook. Focuses on market dynamics and industry analysis. Look for: market analysis, industry research, market trends, competitive analysis."
      },
      {
        "type": "broker_research",
        "description": "Broker research report providing investment analysis, company coverage, financial analysis, and trading recommendations from brokerage firms. Look for: broker analysis, trading recommendation, company coverage, financial analysis."
      },
      {
        "type": "expert_call_transcript",
        "description": "Expert call transcript providing industry insights, market commentary, and expertise from industry experts or consultants. Look for: expert commentary, industry insights, expert interview content, market perspective."
      },
      {
        "type": "management_call_transcript",
        "description": "Management call transcript including earnings calls, investor presentations, and management commentary on business performance and strategy. Look for: management commentary, earnings call, investor communication, strategic updates."
      },
      {
        "type": "customer_call_transcript",
        "description": "Customer call transcript providing customer feedback, customer satisfaction, product insights, and customer experience information. Look for: customer feedback, customer insights, customer experience, product feedback."
      },
      {
        "type": "earnings_call_transcript",
        "description": "Earnings call transcript including Q&A with analysts, financial results discussion, and management commentary on quarterly performance and outlook. Look for: earnings discussion, Q&A content, financial results, management outlook."
      },
      {
        "type": "other_transcript",
        "description": "Other transcript types including various interviews, discussions, and conversations related to investment analysis. Look for: transcript content, discussion material, interview content."
      },
      {
        "type": "not_known",
        "description": "Document type cannot be determined from available information."
      },
      {
        "type": "other",
        "description": "Any other document type not specifically categorized above."
      }
    ],
    "mode": "FAST",
    "parsing_configuration": {
      "max_pages": 5
    }
  },
  "extract-investment": {
    "product_type": "extract_v2",
    "configuration_id": null,
    "data_schema": {
      "description": "Schema for extracting investment due diligence information from documents (VDD/buyside DD, IMs, pitch decks, market research, transcripts). Follows strict anti-hallucination policy with source grounding and factual accuracy.",
      "properties": {
        "document_metadata": {
          "type": "object",
          "description": "Metadata describing the source document itself including company name, document type, producer information, and version details.",
          "properties": {
            "company_name": {
              "type": "string",
              "description": "Name of the company being analysed in the document."
            },
            "document_type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "commercial_dd", "tech_it_dd", "financial_dd", "operations_dd",
                    "legal_dd", "regulatory_dd", "esg_dd", "hr_people_dd",
                    "tax_dd", "insurance_dd", "environmental_dd",
                    "investment_memorandum", "information_memorandum_teaser",
                    "management_presentation", "pitch_deck", "financial_statement",
                    "annual_report", "quarterly_report", "internal_document",
                    "board_pack", "analyst_report", "market_research_report",
                    "broker_research", "expert_call_transcript", "management_call_transcript",
                    "customer_call_transcript", "earnings_call_transcript",
                    "other_transcript", "not_known", "other"
                  ]
                },
                {"type": "null"}
              ],
              "description": "Type of document being processed."
            },
            "document_producer": {
              "anyOf": [{"type": "string"}, {"type": "null"}],
              "description": "Name of the firm or team that produced the document."
            },
            "producer_type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "investment_bank", "consulting_firm", "accounting_firm", "law_firm",
                    "private_equity_firm", "venture_capital_firm", "hedge_fund", "company_internal",
                    "research_firm", "brokerage_firm", "expert_network", "other", "not_known"
                  ]
                },
                {"type": "null"}
              ],
              "description": "Category of document producer."
            },
            "dd_side": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["vendor", "buyside", "joint_vendor_buyside", "not_applicable", "not_known"]
                },
                {"type": "null"}
              ],
              "description": "For DD documents: whether vendor or buyside."
            }
          }
        },
        "company_overview": {
          "type": "object",
          "description": "Company information including business description, management team, ownership structure, and company fundamentals.",
          "properties": {
            "business_description": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {"type": "string"},
                    "quotes": {"type": "array", "items": {"type": "string"}},
                    "attribution": {"type": "string"}
                  }
                },
                {"type": "null"}
              ],
              "description": "Description of the company's business model, products/services, and operations."
            },
            "management_team": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "key_executives": {"type": "array", "items": {"type": "object"}},
                    "board_composition": {"type": "array", "items": {"type": "object"}},
                    "management_assessment": {"type": "object"}
                  }
                },
                {"type": "null"}
              ],
              "description": "Management team information and assessment."
            }
          }
        },
        "market_analysis": {
          "type": "object",
          "description": "Market analysis including TAM/SAM/SOM and competitive positioning.",
          "properties": {
            "market_size": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "tam": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "sam": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "som": {"anyOf": [{"type": "object"}, {"type": "null"}]}
                  }
                },
                {"type": "null"}
              ],
              "description": "Total Addressable Market, Serviceable Addressable Market, Serviceable Obtainable Market."
            },
            "competitive_positioning": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "competitive_landscape": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "competitor_name": {"type": "string"},
                              "market_position": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "market_share": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["competitor_name"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "market_share": {"type": "object"},
                    "competitive_advantages": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "advantage_type": {"type": "string"},
                              "description": {"type": "string"},
                              "sustainability": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["advantage_type", "description"]
                          }
                        },
                        {"type": "null"}
                      ]
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Competitive position and market share analysis."
            }
          }
        },
        "company_analysis": {
          "type": "object",
          "description": "Company analysis including business model and competitive moat.",
          "properties": {
            "business_model": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "revenue_model": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "value_proposition": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "go_to_market_strategy": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "channel": {"type": "string"},
                              "description": {"type": "string"},
                              "effectiveness": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["channel", "description"]
                          }
                        },
                        {"type": "null"}
                      ]
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Business model analysis and revenue generation approach."
            },
            "competitive_moat": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "moat_components": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "component_type": {"type": "string"},
                              "description": {"type": "string"},
                              "strength": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["component_type", "description"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "sustainability_assessment": {"anyOf": [{"type": "object"}, {"type": "null"}]}
                  }
                },
                {"type": "null"}
              ],
              "description": "Competitive moat analysis and sustainability."
            }
          }
        },
        "financial_profile": {
          "type": "object",
          "description": "Financial profile including financial statements, revenue mix, and profitability metrics.",
          "properties": {
            "financial_statements": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "balance_sheet": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "income_statement": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "cash_flow_statement": {"anyOf": [{"type": "object"}, {"type": "null"}]}
                  }
                },
                {"type": "null"}
              ],
              "description": "Historical financial statements and key line items."
            },
            "revenue_mix": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "by_product": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "category": {"type": "string"},
                              "amount": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "growth_rate": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["category"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "by_geography": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "category": {"type": "string"},
                              "amount": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "growth_rate": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["category"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "by_customer_segment": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "category": {"type": "string"},
                              "amount": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "growth_rate": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["category"]
                          }
                        },
                        {"type": "null"}
                      ]
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Revenue breakdown by product, geography, and customer segment."
            },
            "profitability_metrics": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "gross_margin": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "operating_margin": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "ebitda_margin": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "net_margin": {"anyOf": [{"type": "object"}, {"type": "null"}]}
                  }
                },
                {"type": "null"}
              ],
              "description": "Key profitability metrics and trends."
            }
          }
        },
        "document_stated_upsides_and_growth_signals": {
          "type": "object",
          "description": "Document-stated upsides and growth signals including growth drivers, opportunities, and positive factors.",
          "properties": {
            "growth_drivers": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Key drivers of business growth and expansion opportunities."
            },
            "market_opportunities": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Market opportunities and expansion potential."
            }
          }
        },
        "document_stated_risks": {
          "type": "object",
          "description": "Document-stated risks including business, financial, operational, regulatory, and other risk factors.",
          "properties": {
            "business_risks": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Business-related risks and challenges."
            },
            "financial_risks": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Financial risks including liquidity, leverage, and market risks."
            },
            "regulatory_risks": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Regulatory and compliance risks."
            }
          }
        },
        "valuation_and_capital_structure_signals": {
          "type": "object",
          "description": "Valuation and capital structure analysis including valuation metrics, cap table, funding history, and capital structure.",
          "properties": {
            "valuation_metrics": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "enterprise_value": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "equity_value": {"anyOf": [{"type": "object"}, {"type": "null"}]},
                    "multiples": {"anyOf": [{"type": "object"}, {"type": "null"}]}
                  }
                },
                {"type": "null"}
              ],
              "description": "Valuation metrics and comparable analysis."
            },
            "capital_structure": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "debt_structure": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "debt_type": {"type": "string"},
                              "amount": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "interest_rate": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "maturity": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "covenants": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["debt_type"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "equity_structure": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "shareholder_type": {"type": "string"},
                              "ownership_pct": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "shares": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "rights": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["shareholder_type"]
                          }
                        },
                        {"type": "null"}
                      ]
                    },
                    "funding_history": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "round_type": {"type": "string"},
                              "amount": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "date": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "investors": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                              "valuation": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                            },
                            "required": ["round_type"]
                          }
                        },
                        {"type": "null"}
                      ]
                    }
                  }
                },
                {"type": "null"}
              ],
              "description": "Capital structure and funding information."
            }
          }
        },
        "merger_considerations": {
          "anyOf": [
            {
              "type": "object",
              "description": "Merger-specific considerations (conditional on deal type).",
              "properties": {
                "integration_risks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                "synergies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                }
              }
            },
            {"type": "null"}
          ],
          "description": "Merger considerations (only when deal_type='merger')."
        },
        "carveout_considerations": {
          "anyOf": [
            {
              "type": "object",
              "description": "Carveout-specific considerations (conditional on deal type).",
              "properties": {
                "standalone_operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                },
                "service_agreements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"type": "array", "items": {"type": "string"}},
                      "attribution": {"type": "string"}
                    }
                  }
                }
              }
            },
            {"type": "null"}
          ],
          "description": "Carveout considerations (only when deal_type='carve_out')."
        },
        "technology_and_it": {
          "type": "object",
          "description": "Technology and IT analysis including technology stack, IT infrastructure, cybersecurity, and technical capabilities.",
          "properties": {
            "technology_stack": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {"type": "string"},
                      "quotes": {"anyOf": [{"type": "array", "items": {"type": "string"}}, {"type": "null"}]},
                      "attribution": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                    },
                    "required": ["value"]
                  }
                },
                {"type": "null"}
              ],
              "description": "Technology stack and technical infrastructure."
            },
            "cybersecurity_posture": {
