{
  "classify": {
    "product_type": "classify_v2",
    "configuration_id": null,
    "rules": [
      {
        "type": "commercial_dd",
        "description": "Commercial due diligence report analyzing market positioning, competitive landscape, customer base, revenue model, and growth opportunities. Focuses on market size (TAM/SAM/SOM), competitive moat, unit economics, and commercial viability. Look for: market analysis, customer interviews, competitive analysis, revenue drivers."
      },
      {
        "type": "tech_it_dd",
        "description": "Technology and IT due diligence report evaluating technology stack, software architecture, IT infrastructure, cybersecurity posture, technical debt, scalability, and technology capabilities. Look for: technology assessment, system architecture, security review, technical infrastructure analysis."
      },
      {
        "type": "financial_dd",
        "description": "Financial due diligence report analyzing financial statements, revenue quality, profitability, working capital, cash flow, debt structure, and financial projections. Focuses on financial health, accounting quality, and financial performance. Look for: financial analysis, accounting review, quality of earnings, financial projections."
      },
      {
        "type": "operations_dd",
        "description": "Operations due diligence report evaluating operational efficiency, supply chain, manufacturing processes, operational metrics, cost structure, and operational capabilities. Focuses on operational excellence and scalability. Look for: operational assessment, supply chain analysis, manufacturing capabilities, operational efficiency."
      },
      {
        "type": "legal_dd",
        "description": "Legal due diligence report reviewing corporate structure, contracts, intellectual property, regulatory compliance, litigation, and legal risks. Focuses on legal health and potential liabilities. Look for: legal review, contract analysis, IP assessment, regulatory compliance."
      },
      {
        "type": "regulatory_dd",
        "description": "Regulatory due diligence report analyzing regulatory environment, compliance status, regulatory risks, licenses, permits, and regulatory challenges. Focuses on regulatory compliance and risks. Look for: regulatory assessment, compliance review, licensing analysis."
      },
      {
        "type": "esg_dd",
        "description": "Environmental, Social, and Governance due diligence report evaluating ESG factors, sustainability practices, social impact, governance structure, and ESG risks/opportunities. Look for: ESG assessment, sustainability analysis, governance review, social impact evaluation."
      },
      {
        "type": "hr_people_dd",
        "description": "Human Resources and People due diligence report analyzing workforce composition, organizational structure, talent acquisition, retention, compensation, and human capital risks. Look for: HR assessment, organizational analysis, talent review, compensation structure."
      },
      {
        "type": "tax_dd",
        "description": "Tax due diligence report reviewing tax structure, tax compliance, tax liabilities, tax planning, and tax risks. Focuses on tax efficiency and compliance. Look for: tax analysis, compliance review, tax structure assessment."
      },
      {
        "type": "insurance_dd",
        "description": "Insurance due diligence report evaluating insurance coverage, risk management, claims history, insurance adequacy, and insurance gaps. Look for: insurance review, risk assessment, coverage analysis."
      },
      {
        "type": "environmental_dd",
        "description": "Environmental due diligence report analyzing environmental impact, contamination, environmental compliance, environmental risks, and sustainability practices. Look for: environmental assessment, contamination review, compliance analysis."
      },
      {
        "type": "investment_memorandum",
        "description": "Investment memorandum providing investment thesis, opportunity overview, financial highlights, market positioning, and investment rationale. Typically prepared by investment banks or financial advisors. Look for: investment thesis, opportunity overview, investment rationale, financial highlights."
      },
      {
        "type": "information_memorandum_teaser",
        "description": "Information memorandum teaser or preliminary investment document providing high-level overview of investment opportunity, key highlights, and basic investment information. Look for: teaser content, opportunity overview, key investment highlights."
      },
      {
        "type": "management_presentation",
        "description": "Management presentation or pitch deck presenting company overview, business model, market opportunity, financial performance, and growth strategy to investors. Look for: company overview, business model, market opportunity, financial presentation."
      },
      {
        "type": "pitch_deck",
        "description": "Pitch deck presenting investment opportunity, business concept, market opportunity, team, and investment terms to potential investors. Look for: pitch content, investment proposition, business concept presentation."
      },
      {
        "type": "financial_statement",
        "description": "Financial statement including balance sheet, income statement, cash flow statement, and financial metrics. Focuses on historical financial performance and position. Look for: financial statements, balance sheet, income statement, cash flow statement."
      },
      {
        "type": "annual_report",
        "description": "Annual report including financial statements, management discussion, business overview, and corporate governance information. Provides comprehensive annual performance review. Look for: annual financial report, MD&A, business description, corporate governance."
      },
      {
        "type": "quarterly_report",
        "description": "Quarterly report including quarterly financial statements, management discussion, and business updates. Focuses on quarterly performance and period-over-period comparisons. Look for: quarterly financial report, quarterly results, period updates."
      },
      {
        "type": "internal_document",
        "description": "Internal company document including strategy documents, internal memos, board materials, and internal analysis. Look for: internal content, strategy documents, internal analysis, board materials."
      },
      {
        "type": "board_pack",
        "description": "Board pack or board meeting materials including board presentations, financial reports, strategic updates, and governance information prepared for board meetings. Look for: board materials, board presentation, governance content."
      },
      {
        "type": "analyst_report",
        "description": "Analyst report providing investment analysis, company assessment, financial analysis, and investment recommendations from sell-side or buy-side analysts. Look for: analyst analysis, investment recommendation, company assessment, financial analysis."
      },
      {
        "type": "market_research_report",
        "description": "Market research report providing industry analysis, market size, trends, competitive landscape, and market outlook. Focuses on market dynamics and industry analysis. Look for: market analysis, industry research, market trends, competitive analysis."
      },
      {
        "type": "broker_research",
        "description": "Broker research report providing investment analysis, company coverage, financial analysis, and trading recommendations from brokerage firms. Look for: broker analysis, trading recommendation, company coverage, financial analysis."
      },
      {
        "type": "expert_call_transcript",
        "description": "Expert call transcript providing industry insights, market commentary, and expertise from industry experts or consultants. Look for: expert commentary, industry insights, expert interview content, market perspective."
      },
      {
        "type": "management_call_transcript",
        "description": "Management call transcript including earnings calls, investor presentations, and management commentary on business performance and strategy. Look for: management commentary, earnings call, investor communication, strategic updates."
      },
      {
        "type": "customer_call_transcript",
        "description": "Customer call transcript providing customer feedback, customer satisfaction, product insights, and customer experience information. Look for: customer feedback, customer insights, customer experience, product feedback."
      },
      {
        "type": "earnings_call_transcript",
        "description": "Earnings call transcript including Q&A with analysts, financial results discussion, and management commentary on quarterly performance and outlook. Look for: earnings discussion, Q&A content, financial results, management outlook."
      },
      {
        "type": "other_transcript",
        "description": "Other transcript types including various interviews, discussions, and conversations related to investment analysis. Look for: transcript content, discussion material, interview content."
      },
      {
        "type": "not_known",
        "description": "Document type cannot be determined from available information."
      },
      {
        "type": "other",
        "description": "Any other document type not specifically categorized above."
      }
    ],
    "mode": "FAST",
    "parsing_configuration": {
      "max_pages": 5
    }
  },
