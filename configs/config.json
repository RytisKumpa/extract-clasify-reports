                },
                "competitive_positioning": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "competitive_landscape": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "competitor_name": {
                                    "type": "string"
                                  },
                                  "market_position": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "market_share": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "competitor_name"
                                ]
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "market_share": {
                          "type": "object"
                        },
                        "competitive_advantages": {
                          "anyOf": [
                            {
                              "type": "array",
